class Solution {
    public int[] intersect(int[] nums1, int[] nums2) {
        HashMap<Integer, Integer> map = new HashMap<>(); 
        HashMap<Integer, Integer> map1 = new HashMap<>();

        int l1 = nums1.length; 
        int l2 = nums2.length; 
        int k = 0;
        int p = 0;
        
        for(int i=0 ; i<l1; i++){
            map.put(k,nums1[i]);
            k++;
        }

        for(int m=0 ; m<l2; m++){
            map1.put(p,nums2[m]);
            p++; 
        }

        ArrayList<Integer> toDelete = new ArrayList<>();

        for(int s : map.keySet()){
            boolean f = false; 
            
            for(int j : map1.keySet()){ 
                if(map.get(s).equals(map1.get(j))){
                    f = true; 
                    map1.remove(j); 
                    break;          
                }
            }
            
            if(f == false){
                toDelete.add(s);
            }
        } 

        for(int s : toDelete){
            map.remove(s);
        }

        int[] array = map.values().stream().mapToInt(Integer::intValue).toArray();
        return array;
    }
}

OPTIMIZED SOLUTION:
class Solution {
    public int[] intersect(int[] nums1, int[] nums2) {

        int[] arr1 = new int[1001];
        int[] arr2 = new int[1001];

        for(int i: nums1) arr1[i]++;
        for(int i: nums2) arr2[i]++;

        ArrayList<Integer> al = new ArrayList<>();

        for(int i=0; i<arr1.length; i++) {
            if(arr1[i] != 0 && arr2[i] != 0) {
                int occ = Math.min(arr1[i], arr2[i]);
                for(int j=0; j<occ; j++) {
                    al.add(i);
                }
            }
        }

        int[] result = new int[al.size()];
        for(int i=0; i<al.size(); i++) {
            result[i] = al.get(i);
        }

        return result;
    }
}
