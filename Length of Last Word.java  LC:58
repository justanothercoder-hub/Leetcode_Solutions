class Solution {
    public int lengthOfLastWord(String s) {
        int l = s.length();
        int length=0;

        for (int i = l-1; i>=0; i-- ){
            char ch = s.charAt(i);

            if(ch != ' '){
               length++;
            }
            else if(length>0 && ch == ' '){
                break;
            }
        }

        return length;
        
    }
}
